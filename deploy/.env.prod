ENV=prod


DATABASE_URL=postgres://nexus-studio:${DB_PASSWORD}@172.17.0.1:5432/nexus-studio
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@172.17.0.1:6379/15
CHECKPOINTER_POSTGRES_URI=postgresql://nexus-studio:${DB_PASSWORD}@172.17.0.1:5432/nexus-studio

JWT_SECRET_KEY=${JWT_SECRET_KEY}

FRONTEND_BASE_URL=https://nexus-studio.presentserver.com
FRONTEND_RESET_PASSWORD_URL=https://nexus-studio.presentserver.com/reset-password
CORS_ORIGINS=https://nexus-studio.presentserver.com

# 邮件
ALIYUN_ACCESS_KEY_ID=${ALIYUN_ACCESS_KEY_ID}
ALIYUN_ACCESS_KEY_SECRET=${ALIYUN_ACCESS_KEY_SECRET}
ALIYUN_DM_ACCOUNT_NAME=support@presentserver.com

GATEWAY_BASE_URL=http://union-lm-dev-backend:8083
GATEWAY_API_KEY=${GATEWAY_API_KEY}
GATEWAY_CALLBACK_BASE_URL=https://nexus-studio.presentserver.com
GENERATE_CALLBACK_URL=https://nexus-studio.presentserver.com/api/v1/generate/callback

