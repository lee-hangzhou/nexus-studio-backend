TOS_SECRET_KEY=${TOS_SECRET_KEY}


CHAT_WORKSPACE_ROOT=/var/lib/nexus-studio/chat-workspaces
CHAT_SANDBOX_PACKAGES_ROOT=/var/lib/nexus-studio/sandbox-packages

BOCHA_API_KEY=${BOCHA_API_KEY}

# Creem one-time credit packs (1 USD = 10 credits; fill live keys/products from Creem dashboard)
CREEM_API_KEY=${CREEM_API_KEY}
CREEM_WEBHOOK_SECRET=${CREEM_WEBHOOK_SECRET}
