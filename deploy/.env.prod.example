ENV=prod

# PostgreSQL / Redis（Docker 内访问宿主机常用 172.17.0.1）
DATABASE_URL=postgresql://dream_drama:YOUR_PASSWORD@YOUR_POSTGRES_HOST:5432/dream_drama
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@YOUR_REDIS_HOST:6379/15
CHECKPOINTER_POSTGRES_URI=postgresql://dream_drama:YOUR_PASSWORD@YOUR_POSTGRES_HOST:5432/dream_drama

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

FRONTEND_BASE_URL=https://YOUR_DOMAIN
FRONTEND_RESET_PASSWORD_URL=https://YOUR_DOMAIN/reset-password
CORS_ORIGINS=https://YOUR_DOMAIN

# 邮件
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=support@presentserver.com

GATEWAY_BASE_URL=http://YOUR_UNION_LM_SERVICE:8083
GATEWAY_API_KEY=YOUR_GATEWAY_API_KEY
GATEWAY_CALLBACK_BASE_URL=https://YOUR_BACKEND_DOMAIN
GENERATE_CALLBACK_URL=https://YOUR_BACKEND_DOMAIN/api/v1/generate/callback
# 代码默认为空；生产需指定
GATEWAY_CAPTION_MODEL=qwen3-vl-plus
SKILL_DESCRIPTION_FILL_MODEL=deepseek-v4-pro

TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_ACCESS_KEY=
TOS_SECRET_KEY=


CHAT_WORKSPACE_ROOT=/var/lib/dream-drama/chat-workspaces
CHAT_SANDBOX_PACKAGES_ROOT=/var/lib/dream-drama/sandbox-packages

BOCHA_API_KEY=
