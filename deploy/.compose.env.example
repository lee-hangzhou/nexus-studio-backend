# Compose-only deployment settings. Copy to .compose.env on the host.

# Preserve the current host binding behind the external reverse proxy.
FRONTEND_BIND=127.0.0.1:82

# Use immutable Git SHA tags for production releases.
BACKEND_IMAGE=dream-drama-prod-backend:latest
FRONTEND_IMAGE=dream-drama-prod-frontend:latest

# Shared network for frontend, backend, and dynamically created browser containers.
DEPLOY_NETWORK=dream-drama-network

# Template/CI validation is secret-free. Production .compose.env must use .env.prod.
BACKEND_ENV_FILE=.env.prod.example
