        "kind": {
          "$ref": "#/$defs/GenerationKind"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "queue_position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Position"
        },
        "queue_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Total"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "ref_materials": {
          "items": {
            "$ref": "#/$defs/GenerateRefMaterial"
          },
          "title": "Ref Materials",
          "type": "array"
        },
        "reference_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "result_asset_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Result Asset Ids",
          "type": "array"
