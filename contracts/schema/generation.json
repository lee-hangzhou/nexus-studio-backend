          "default": null,
          "title": "Duration"
        },
        "framesPerSecond": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framespersecond"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "type": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "url"
      ],
      "title": "GatewayResultItem",
      "type": "object"
    },
    "GenerateMaterialLimits": {
      "additionalProperties": false,
      "description": "产品 list_models.param_options.material_limits，与网关目录同构。",
      "properties": {
        "allow_audio_only": {
          "default": false,
          "title": "Allow Audio Only",
          "type": "boolean"
        },
        "audios": {
          "default": 0,
          "title": "Audios",
          "type": "integer"
        },
        "images": {
          "default": 0,
          "title": "Images",
          "type": "integer"
        },
        "requires_any": {
          "default": false,
          "title": "Requires Any",
          "type": "boolean"
        },
        "videos": {
          "default": 0,
          "title": "Videos",
          "type": "integer"
        }
      },
      "title": "GenerateMaterialLimits",
      "type": "object"
    },
    "GenerateModelItem": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/GenerationKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "param_options": {
          "$ref": "#/$defs/GenerateParamOptions"
        },
        "supports_vision": {
          "default": false,
          "title": "Supports Vision",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "label",
        "kind"
      ],
      "title": "GenerateModelItem",
      "type": "object"
    },
    "GenerateParamOptions": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "items": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "array"
        },
        "durations": {
          "items": {
            "type": "integer"
          },
          "title": "Durations",
          "type": "array"
        },
        "material_limits": {
          "$ref": "#/$defs/GenerateMaterialLimits"
        },
        "ratios": {
          "items": {
            "type": "string"
          },
          "title": "Ratios",
          "type": "array"
        },
        "ratios_by_resolution": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Ratios By Resolution",
          "type": "object"
        },
        "reference_modes": {
          "items": {
            "$ref": "#/$defs/ReferenceModeOption"
          },
          "title": "Reference Modes",
          "type": "array"
        },
        "resolutions": {
          "items": {
            "type": "string"
          },
          "title": "Resolutions",
          "type": "array"
        }
      },
      "title": "GenerateParamOptions",
      "type": "object"
    },
    "GenerateRefMaterial": {
      "properties": {
        "asset_id": {
          "minimum": 1,
          "title": "Asset Id",
          "type": "integer"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "filename",
        "mime_type",
        "url"
      ],
      "title": "GenerateRefMaterial",
      "type": "object"
    },
    "GenerateTaskCursor": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "task_id": {
          "exclusiveMinimum": 0,
          "title": "Task Id",
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "task_id"
      ],
      "title": "GenerateTaskCursor",
      "type": "object"
    },
    "GenerateTaskListItem": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
