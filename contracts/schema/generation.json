        },
        "preview_media_type": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Media Type"
        },
        "preview_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Url"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "queue_position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Position"
        },
        "queue_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Total"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "reference_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "result_count": {
          "default": 0,
          "title": "Result Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/GenerationTaskStatus"
        },
        "task_id": {
          "title": "Task Id",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "kind",
        "status",
        "prompt",
        "model_id",
        "created_at"
      ],
      "title": "GenerateTaskListItem",
      "type": "object"
    },
    "GenerateTaskListRequest": {
      "properties": {
        "created_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created After"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerateTaskCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "favorites_only": {
          "default": false,
          "title": "Favorites Only",
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_size": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "query": {
          "default": "",
          "title": "Query",
          "type": "string"
        },
        "statuses": {
          "items": {
            "$ref": "#/$defs/GenerationTaskStatus"
          },
          "title": "Statuses",
          "type": "array"
        }
      },
      "title": "GenerateTaskListRequest",
      "type": "object"
    },
    "GenerateTaskListResponse": {
      "properties": {
        "has_more": {
          "default": false,
          "title": "Has More",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/GenerateTaskListItem"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerateTaskCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "items"
      ],
      "title": "GenerateTaskListResponse",
      "type": "object"
    },
    "GenerateTaskView": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "estimated_wait_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Wait Seconds"
        },
        "is_favorited": {
          "default": false,
          "title": "Is Favorited",
