        "type": {
          "$ref": "#/$defs/GatewayContentType"
        }
      },
      "required": [
        "type"
      ],
      "title": "GatewayContentPart",
      "type": "object"
    },
    "GatewayContentType": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "GatewayContentType",
      "type": "integer"
    },
    "GatewayGenerateCallback": {
      "description": "对齐 union_lm api.TaskResponse（callback 直 POST，无外层信封）。",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
