      "type": "object"
    },
    "CanvasPatchRequest": {
      "additionalProperties": false,
      "properties": {
        "ops": {
          "items": {
            "discriminator": {
              "mapping": {
                "connect": "#/$defs/ConnectNodesOp",
                "create_node": "#/$defs/CreateNodeOp",
                "delete_node": "#/$defs/DeleteNodeOp",
                "disconnect": "#/$defs/DisconnectNodesOp",
                "update_node": "#/$defs/UpdateNodeOp"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CreateNodeOp"
              },
              {
                "$ref": "#/$defs/UpdateNodeOp"
              },
              {
                "$ref": "#/$defs/DeleteNodeOp"
              },
              {
                "$ref": "#/$defs/ConnectNodesOp"
              },
              {
                "$ref": "#/$defs/DisconnectNodesOp"
              }
            ]
          },
          "minItems": 1,
          "title": "Ops",
          "type": "array"
        }
      },
      "required": [
        "ops"
      ],
      "title": "CanvasPatchRequest",
      "type": "object"
    },
    "CanvasPatchResponse": {
      "additionalProperties": false,
      "properties": {
        "deleted_edge_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Deleted Edge Ids",
          "type": "array"
        },
        "deleted_node_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Deleted Node Ids",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CanvasEdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CanvasNodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "op_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op Id"
        }
      },
      "title": "CanvasPatchResponse",
      "type": "object"
    },
    "CanvasPosition": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CanvasPosition",
      "type": "object"
    },
    "CanvasRevisionConflictItem": {
      "additionalProperties": false,
      "properties": {
        "actual_revision": {
          "title": "Actual Revision",
          "type": "integer"
        },
        "expected_revision": {
          "title": "Expected Revision",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "node",
            "edge"
