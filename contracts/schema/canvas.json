{
  "$defs": {
    "CanvasBindUploadRequest": {
      "additionalProperties": false,
      "description": "将已登记资产绑定为节点上传结果",
      "properties": {
        "asset_id": {
          "minimum": 1,
          "title": "Asset Id",
          "type": "integer"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "CanvasBindUploadRequest",
      "type": "object"
    },
    "CanvasEdgeType": {
      "enum": [
        "dependency"
      ],
      "title": "CanvasEdgeType",
      "type": "string"
    },
    "CanvasEdgeView": {
      "additionalProperties": false,
      "properties": {
        "edge_type": {
          "$ref": "#/$defs/CanvasEdgeType"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "source": {
          "format": "uuid",
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "$ref": "#/$defs/CanvasSourcePort"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "$ref": "#/$defs/CanvasTargetPort"
        }
      },
      "required": [
        "id",
        "revision",
        "source",
        "target",
        "source_port",
        "target_port",
        "edge_type"
      ],
      "title": "CanvasEdgeView",
      "type": "object"
    },
    "CanvasNodeAssetPath": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "thumb_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumb Url"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "CanvasNodeAssetPath",
      "type": "object"
    },
    "CanvasNodeConfig": {
      "additionalProperties": false,
      "description": "节点生成配置（对齐参考可写集；不含未接入能力）",
      "properties": {
        "aspect_ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Ratio"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "duration_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Sec"
        },
        "emotion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotion"
        },
        "image_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Size"
        },
        "img_num": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Img Num"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pitch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "reference_mode": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Mode"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed"
        },
        "text_num": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Num"
        },
        "voice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Id"
        },
        "voice_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Name"
        },
        "vol": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vol"
        }
      },
      "title": "CanvasNodeConfig",
      "type": "object"
    },
    "CanvasNodeData": {
      "additionalProperties": false,
      "description": "节点业务字段；持久化在 canvas_nodes.data JSONB\n\n语义（对齐参考）：\n- text：content=正文(str)；prompt_content=生成输入(segments)；prompt=派生纯文本\n- media：content=结构化 prompt(segments)；prompt=派生纯文本",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasNodeConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "audio_url": "#/$defs/WorkflowPromptMediaSegment",
                    "image_url": "#/$defs/WorkflowPromptMediaSegment",
                    "text": "#/$defs/WorkflowPromptTextSegment",
                    "text_ref": "#/$defs/WorkflowPromptTextRefSegment",
                    "video_url": "#/$defs/WorkflowPromptMediaSegment"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/WorkflowPromptTextSegment"
                  },
                  {
                    "$ref": "#/$defs/WorkflowPromptMediaSegment"
                  },
                  {
                    "$ref": "#/$defs/WorkflowPromptTextRefSegment"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "generate_created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Created At"
        },
        "generate_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Error"
        },
        "generate_operation_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Operation Type"
        },
        "generate_task_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Task Id"
        },
        "library_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ImagePromptLibraryRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library Refs"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_asset_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Asset Ids"
        },
        "output_source": {
          "anyOf": [
            {
              "enum": [
                "upload",
                "generated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Source"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CanvasNodeAssetPath"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paths"
        },
        "preview_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Url"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "prompt_content": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "audio_url": "#/$defs/WorkflowPromptMediaSegment",
                    "image_url": "#/$defs/WorkflowPromptMediaSegment",
                    "text": "#/$defs/WorkflowPromptTextSegment",
                    "text_ref": "#/$defs/WorkflowPromptTextRefSegment",
                    "video_url": "#/$defs/WorkflowPromptMediaSegment"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/WorkflowPromptTextSegment"
                  },
                  {
                    "$ref": "#/$defs/WorkflowPromptMediaSegment"
                  },
                  {
                    "$ref": "#/$defs/WorkflowPromptTextRefSegment"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Content"
        },
        "results": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasTaskResults"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasNodeStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "CanvasNodeData",
      "type": "object"
    },
    "CanvasNodeKind": {
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ],
      "title": "CanvasNodeKind",
      "type": "string"
    },
    "CanvasNodeStatus": {
      "enum": [
        "idle",
        "waiting_inputs",
        "ready",
        "running",
        "success",
        "failed",
        "cancelled"
      ],
      "title": "CanvasNodeStatus",
      "type": "string"
    },
    "CanvasNodeView": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/CanvasNodeData"
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CanvasNodeKind"
        },
        "output_asset_urls": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Asset Urls"
        },
        "position": {
          "$ref": "#/$defs/CanvasPosition"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "id",
        "kind",
        "revision",
        "position"
      ],
      "title": "CanvasNodeView",
      "type": "object"
    },
    "CanvasPatchRequest": {
      "additionalProperties": false,
      "properties": {
        "ops": {
          "items": {
            "discriminator": {
              "mapping": {
                "connect": "#/$defs/ConnectNodesOp",
                "create_node": "#/$defs/CreateNodeOp",
                "delete_node": "#/$defs/DeleteNodeOp",
                "disconnect": "#/$defs/DisconnectNodesOp",
                "update_node": "#/$defs/UpdateNodeOp"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CreateNodeOp"
              },
              {
                "$ref": "#/$defs/UpdateNodeOp"
              },
              {
                "$ref": "#/$defs/DeleteNodeOp"
              },
              {
                "$ref": "#/$defs/ConnectNodesOp"
              },
              {
                "$ref": "#/$defs/DisconnectNodesOp"
              }
            ]
          },
          "minItems": 1,
          "title": "Ops",
          "type": "array"
        }
      },
      "required": [
        "ops"
      ],
      "title": "CanvasPatchRequest",
      "type": "object"
    },
    "CanvasPatchResponse": {
      "additionalProperties": false,
      "properties": {
        "deleted_edge_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Deleted Edge Ids",
          "type": "array"
        },
        "deleted_node_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Deleted Node Ids",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CanvasEdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CanvasNodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "op_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op Id"
        }
      },
      "title": "CanvasPatchResponse",
      "type": "object"
    },
    "CanvasPosition": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CanvasPosition",
      "type": "object"
    },
    "CanvasRevisionConflictItem": {
      "additionalProperties": false,
      "properties": {
        "actual_revision": {
          "title": "Actual Revision",
          "type": "integer"
        },
        "expected_revision": {
          "title": "Expected Revision",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "node",
            "edge"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_revision",
        "actual_revision"
      ],
      "title": "CanvasRevisionConflictItem",
      "type": "object"
    },
    "CanvasSessionCreateRequest": {
      "additionalProperties": false,
      "description": "新建画布会话",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "CanvasSessionCreateRequest",
      "type": "object"
    },
    "CanvasSessionIdRequest": {
      "additionalProperties": false,
      "description": "按 session_id 操作",
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "integer"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "CanvasSessionIdRequest",
      "type": "object"
    },
    "CanvasSessionStatus": {
      "enum": [
        1,
        2
      ],
      "title": "CanvasSessionStatus",
      "type": "integer"
    },
    "CanvasSessionUpdateRequest": {
      "additionalProperties": false,
      "description": "更新画布会话标题",
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "integer"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "title"
      ],
      "title": "CanvasSessionUpdateRequest",
      "type": "object"
    },
    "CanvasSessionView": {
      "additionalProperties": false,
      "description": "画布 Agent 会话视图",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "is_default": {
          "title": "Is Default",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/CanvasSessionStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "episode_id",
        "title",
        "status",
        "is_default",
        "created_at",
        "updated_at"
      ],
      "title": "CanvasSessionView",
      "type": "object"
    },
    "CanvasSnapshot": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/CanvasEdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CanvasNodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "project_id": {
          "title": "Project Id",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "episode_id",
        "nodes",
        "edges"
      ],
      "title": "CanvasSnapshot",
      "type": "object"
    },
    "CanvasSourcePort": {
      "enum": [
        "output_text",
        "output_asset"
      ],
      "title": "CanvasSourcePort",
      "type": "string"
    },
    "CanvasTargetPort": {
      "enum": [
        "prompt_input",
        "reference_asset"
      ],
      "title": "CanvasTargetPort",
      "type": "string"
    },
    "CanvasTaskAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "thumb_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumb Url"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "CanvasTaskAsset",
      "type": "object"
    },
    "CanvasTaskResults": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CanvasTaskAsset"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assets"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "raw": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "status": {
          "enum": [
            "success",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "CanvasTaskResults",
