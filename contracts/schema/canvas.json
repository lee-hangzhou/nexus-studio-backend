    "CanvasEdgeType": {
      "enum": [
        "dependency"
      ],
      "title": "CanvasEdgeType",
      "type": "string"
    },
    "CanvasEdgeView": {
      "additionalProperties": false,
      "properties": {
        "edge_type": {
          "$ref": "#/$defs/CanvasEdgeType"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "source": {
          "format": "uuid",
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "$ref": "#/$defs/CanvasSourcePort"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "$ref": "#/$defs/CanvasTargetPort"
        }
      },
      "required": [
        "id",
        "revision",
        "source",
        "target",
        "source_port",
        "target_port",
        "edge_type"
      ],
      "title": "CanvasEdgeView",
      "type": "object"
    },
    "CanvasNodeKind": {
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ],
      "title": "CanvasNodeKind",
      "type": "string"
    },
    "CanvasNodeStatus": {
      "enum": [
        "idle",
        "waiting_inputs",
        "ready",
        "running",
        "success",
        "failed",
        "cancelled"
      ],
      "title": "CanvasNodeStatus",
      "type": "string"
    },
    "CanvasNodeView": {
      "additionalProperties": false,
      "properties": {
        "duration_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Sec"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_prompt": {
          "default": "",
          "title": "Input Prompt",
          "type": "string"
