{
  "$defs": {
    "TurnMediaBlock": {
      "additionalProperties": false,
      "description": "图片 / 视频 / 音频 / 文件块; url 由 BFF enrich 写入",
      "properties": {
        "assetId": {
          "minimum": 1,
          "title": "Assetid",
          "type": "integer"
        },
        "mediaType": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnMediaType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "origin": {
          "$ref": "#/$defs/TurnMediaOrigin"
        },
        "previewUrl": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previewurl"
        },
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "type",
        "origin",
        "assetId"
      ],
      "title": "TurnMediaBlock",
      "type": "object"
    },
    "TurnMediaOrigin": {
      "description": "媒体块语义来源, 不映射第二张资源表",
      "enum": [
        "library",
        "upload"
      ],
      "title": "TurnMediaOrigin",
      "type": "string"
    },
    "TurnMediaType": {
      "description": "媒体类型",
      "enum": [
        "image",
        "video",
        "audio",
        "file"
      ],
      "title": "TurnMediaType",
      "type": "string"
    },
    "TurnNodeBlock": {
      "additionalProperties": false,
      "description": "画布节点引用块",
      "properties": {
        "nodeId": {
          "minLength": 1,
          "title": "Nodeid",
          "type": "string"
        },
        "type": {
          "const": "node",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "type"
      ],
      "title": "TurnNodeBlock",
      "type": "object"
    },
    "TurnSkillBlock": {
      "additionalProperties": false,
      "description": "技能引用内容块",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "const": "skill",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "type"
      ],
      "title": "TurnSkillBlock",
      "type": "object"
    },
    "TurnTextBlock": {
      "additionalProperties": false,
      "description": "文本内容块",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text",
        "type"
      ],
      "title": "TurnTextBlock",
      "type": "object"
    },
    "TurnUserInput": {
      "additionalProperties": false,
      "description": "结构化 turn 用户输入",
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "audio": "#/$defs/TurnMediaBlock",
                "file": "#/$defs/TurnMediaBlock",
                "image": "#/$defs/TurnMediaBlock",
                "node": "#/$defs/TurnNodeBlock",
                "skill": "#/$defs/TurnSkillBlock",
                "text": "#/$defs/TurnTextBlock",
                "video": "#/$defs/TurnMediaBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TurnTextBlock"
              },
              {
                "$ref": "#/$defs/TurnSkillBlock"
              },
              {
                "$ref": "#/$defs/TurnMediaBlock"
              },
              {
                "$ref": "#/$defs/TurnNodeBlock"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "materials": {
          "items": {
            "discriminator": {
              "mapping": {
                "audio": "#/$defs/TurnMediaBlock",
                "file": "#/$defs/TurnMediaBlock",
                "image": "#/$defs/TurnMediaBlock",
                "node": "#/$defs/TurnNodeBlock",
                "video": "#/$defs/TurnMediaBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TurnMediaBlock"
              },
              {
                "$ref": "#/$defs/TurnNodeBlock"
              }
            ]
          },
          "title": "Materials",
          "type": "array"
        }
      },
      "required": [
        "content",
        "materials"
      ],
      "title": "TurnUserInput",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/TurnUserInput"
    },
    {
      "$ref": "#/$defs/TurnTextBlock"
    },
    {
      "$ref": "#/$defs/TurnSkillBlock"
    },
    {
      "$ref": "#/$defs/TurnMediaBlock"
    },
    {
      "$ref": "#/$defs/TurnNodeBlock"
    }
  ]
}
