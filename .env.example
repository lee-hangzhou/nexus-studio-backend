# 本地开发配置模板
# 使用方式：cp .env.example .env ，再填写密钥与密码（.env 已在 .gitignore，勿提交）

# Application
ENV=dev
DEBUG=true
PORT=8000

# Database
DATABASE_URL=postgres://dream_drama:YOUR_PASSWORD@localhost:5432/dream_drama
DATABASE_POOL={"min_size":5,"max_size":20,"connect_timeout_seconds":10,"recycle_seconds":3600}

# Redis
REDIS_URL=redis://localhost:6379/0
# 短命令共享池；画布 /events Pub/Sub 用下面独立池，勿混用
REDIS_MAX_CONNECTIONS=50
CANVAS_EPISODE_EVENTS_REDIS_MAX_CONNECTIONS=256
CANVAS_EPISODE_EVENTS_REDIS_ACQUIRE_TIMEOUT_SEC=20
CANVAS_EPISODE_EVENTS_REDIS_SOCKET_TIMEOUT_SEC=5
CANVAS_EPISODE_EVENTS_ACTIVE_WARN_THRESHOLD=200

# JWT (change in production!)
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URLs
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5

# Register verification code
REGISTER_CODE_EXPIRE_MINUTES=5
REGISTER_CODE_RESEND_SECONDS=60
REGISTER_CODE_LENGTH=6

# Aliyun Direct Mail (template API)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ACCOUNT_NAME=support@presentserver.com
ALIYUN_DM_FROM_ALIAS=Nexus Studio
ALIYUN_DM_TEMPLATE_ID_REGISTER=432287
ALIYUN_DM_TEMPLATE_ID_RESET=432291

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Model gateway（Chat / Embeddings / 资产 enrich 共用 GATEWAY_API_KEY、GATEWAY_USER_ID、GATEWAY_BASE_URL）
GATEWAY_BASE_URL=http://localhost:8083
GATEWAY_API_KEY=
GATEWAY_USER_ID=dream-drama
GATEWAY_CALLBACK_BASE_URL=http://localhost:8000
GATEWAY_TIMEOUTS={"connect_seconds":10,"read_seconds":300,"write_seconds":60,"pool_seconds":10,"generation_seconds":120,"query_seconds":30,"embedding_seconds":120}

# Create / Generate（创作页；TOS 加签复用下方 TOS_*，无需单独配置）
# 本地：dream-drama 端口与 PORT 一致；union_lm 需能访问此 URL（同机用 localhost 即可）
GENERATE_CALLBACK_URL=http://localhost:8000/api/v1/generate/callback
GENERATE_ZOMBIE_THRESHOLD_MINUTES=30
# 生成模型能力来自网关厚目录 GET /api/v1/models（parameters）；勿再配置本地能力枚举。
# Embeddings（/api/v1/embeddings，与 Chat 同一网关；模型 ID 有代码默认值，可按需覆盖）
GATEWAY_TEXT_EMBEDDING_MODEL=text-embedding-v4
GATEWAY_MULTIMODAL_EMBEDDING_MODEL=google/gemini-embedding-2-preview
GATEWAY_EMBEDDING_ENCODING_FORMAT=float
# Text / asset batch vector size (must match text-embedding-v4 dimensions)
ASSET_VECTOR_DIMENSION=1024
GATEWAY_CAPTION_MODEL=default-caption-model

# Chat Agent
# CHAT_MODEL_REGISTRY 仅用于覆盖 family/thinking 等元数据；留空 {} 即可，模型列表来自网关。
CHAT_MODEL_REGISTRY={}
CHAT_DEFAULT_MODEL=gpt-5.5
CHAT_MAX_ITERATIONS=50
CHAT_CONTEXT_BUDGET=120000
CHAT_RECENT_MESSAGE_LIMIT=20
CHAT_SUMMARY_KEEP_TOKENS=20000
CHAT_SUMMARY_TRIM_TO_SUMMARIZE=4000
CHAT_GATEWAY_TIMEOUT_SEC=300
CHAT_COMPLETION_MAX_TOKENS=8192
CHAT_TURN_LOCK_TTL_SEC=1800
CHAT_HEARTBEAT_INTERVAL_SEC=15
CHAT_MAX_TOOL_CALLS=80
CHAT_TURN_WALL_CLOCK_SEC=900
CHAT_TOOL_REPEAT_GUARD=3
CHAT_EMPTY_RECOVERY_ATTEMPTS=2
CHAT_EMPTY_RECOVERY_TIMEOUT_SEC=45
CHAT_TURN_USAGE_LOG_PATH=/tmp/dream-drama-chat-turn-usage.jsonl
CHAT_SSE_PROTOCOL_VERSION=2
CHAT_WORKSPACE_ROOT=/tmp/dream-drama-chat-workspaces
CHAT_SANDBOX_IMAGE=dream-drama-chat-sandbox:latest
CHAT_SANDBOX_TIMEOUT_SEC=180
CHAT_SANDBOX_PACKAGES_ROOT=/tmp/dream-drama-sandbox-packages
CHAT_SANDBOX_PIP_NETWORK=bridge
CHAT_SANDBOX_RUN_NETWORK=none
CHAT_SANDBOX_PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
CHAT_SANDBOX_PIP_TRUSTED_HOST=mirrors.aliyun.com
# Browser session（run-server + session driver 长驻容器；生产与本地均 CHAT_BROWSER_INPROCESS=false）
# 容器自动 -p 映射 run-server 与 driver 端口；exec/capture/gate 均经 driver HTTP API
CHAT_GATE_TTL_SEC=600
CHAT_BROWSER_ENABLED=true
CHAT_BROWSER_INPROCESS=false
# 本地 headed 调试自动化时设为 true（Mac 可见 Chromium）
CHAT_BROWSER_HEADED=false
CHAT_BROWSER_SLOW_MO_MS=0
CHAT_CAPTCHA_DEBUG_ARTIFACTS=false
CHAT_BROWSER_IMAGE=dream-drama-browser-session:latest
CHAT_BROWSER_DOCKER_NETWORK=bridge
CHAT_BROWSER_RUN_SERVER_PORT=3333
CHAT_BROWSER_DRIVER_PORT=3334
CHAT_BROWSER_IDLE_SEC=1800
CHAT_BROWSER_EXEC_TIMEOUT_SEC=180
CHAT_BROWSER_STORAGE_ENABLED=true
CHAT_BROWSER_STORAGE_TTL_SEC=86400
CHAT_BROWSER_DEBUG_CAPTURE_TTL_SEC=604800
CHAT_BROWSER_DEBUG_CAPTURE_MAX_COUNT=30
CHAT_LOGIN_PROBE_TIMEOUT_MS=15000
CHAT_QR_MIN_WIDTH=128
CHAT_QR_MIN_HEIGHT=128
CHAT_QR_REQUIRE_DECODE=true
CHAT_QR_MIN_BBOX_SIZE=64
CHAT_ALLOWED_UPLOAD_EXTS=txt,md,json,csv,docx,xlsx,pptx,pdf,png,jpg,jpeg,webp
CHAT_ALLOWED_UPLOAD_MIMES=text/plain,text/markdown,application/json,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/pdf,image/png,image/jpeg,image/webp
CHAT_TURN_PLAN_CLASSIFIER_ENABLED=false
WEB_TOOL_TIMEOUT_SECONDS=30
BOCHA_API_KEY=
BOCHA_WEB_SEARCH_URL=https://api.bocha.cn/v1/web-search
CHAT_CONTEXT_TIMEZONE=Asia/Shanghai
CHAT_MCP_SERVERS=[]

# Object Storage (TOS - 火山引擎，与 union_lm 共享 bucket，走公网 endpoint)
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_REGION=cn-shanghai
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=union-llm
TOS_PRESIGN_EXPIRY_SECONDS=86400
OBJECT_STORAGE_TIMEOUTS={"connect_seconds":30,"socket_seconds":60,"operation_seconds":120}

# Agent runtime (LangGraph checkpointer)
# CHECKPOINTER_TYPE: 1=SQLite（仅本地调试，需设 CHECKPOINTER_SQLITE_PATH） 2=PostgreSQL（推荐）
AGENT_MAX_RETRIES=2
AGENT_MAX_FOLLOW_UPS=2
CHECKPOINTER_TYPE=2
CHECKPOINTER_POSTGRES_URI=postgresql://dream_drama:YOUR_PASSWORD@localhost:5432/dream_drama

# Agent memory (LangGraph AsyncPostgresStore + LangMem; shares CHECKPOINTER_POSTGRES_URI)
MEMORY_STORE_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_VECTOR_DIMENSION=1024
MEMORY_TOOL_TIMEOUT_SEC=60
# Cover slow gateway embedding and queueing for project semantic inject
MEMORY_INJECTION_TIMEOUT_SEC=60
MEMORY_EXTRACTION_TIMEOUT_SEC=120
# Empty falls back to the turn chat model; non-empty must be in gateway model catalog
MEMORY_EXTRACT_MODEL=
MEMORY_USER_INJECT_FETCH_LIMIT=32
MEMORY_PROJECT_INJECT_LIMIT=5
# Calibrated 2026-07-26 via scripts/calibrate_memory_project_min_score.py (Store asearch on JSON content)
MEMORY_PROJECT_INJECT_MIN_SCORE=0.5678
